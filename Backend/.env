# .env.example
# این فایل را کپی کرده و به .env تغییر نام دهید، سپس مقادیر واقعی را جایگزین کنید.
# .env هرگز نباید به گیت commit شود.

# ---------- دیتابیس ----------
DATABASE_URL="postgresql://postgres:1234@localhost:5432/byelimit_db?schema=public"

# ---------- سرور ----------
PORT=4000
NODE_ENV=development
FRONTEND_URL="https://byelimit.ir,https://www.byelimit.ir"
COOKIE_DOMAIN=".byelimit.ir"

# ---------- JWT (احراز هویت) ----------
JWT_SECRET="یک-رشته-تصادفی-و-طولانی-حداقل-۶۴-کاراکتر-اینجا-قرار-بگیرد"
JWT_EXPIRES_IN="33d"

# ---------- ملی پیامک (پیامک OTP) ----------
# مستندات رسمی: https://www.melipayamak.com/api/sendotp/
# و SDK: https://github.com/Melipayamak/melipayamak-node
# اینجا نام کاربری و کلمه عبور پنل ملی پیامک را وارد کنید.
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
MELIPAYAMAK_FROM=""
MELIPAYAMAK_API_KEY=""
MELIPAYAMAK_OTP_TEMPLATE="byelimit-login"

# ---------- زرین‌پال ----------
ZARINPAL_MERCHANT_ID=""
# true تا وقتی مرچنت واقعی نگرفته‌اید - حتماً پیش از لانچ نهایی false شود
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL="https://byelimit.ir/api/payment/callback"

# ---------- ردیس (برای BullMQ - صف تحویل و اعلان تلگرام) ----------
REDIS_URL="redis://localhost:6379"

# ---------- رمزنگاری اطلاعات حساس (مثل کردنشیال اکانت‌ها) ----------
ACCOUNT_CREDENTIALS_ENCRYPTION_KEY="یک-کلید-۳۲-بایتی-برای-AES-256-اینجا"

# ---------- API داخلی ربات تلگرام پشتیبانی ----------
# یک رشته تصادفی طولانی بسازید و همین مقدار را در تنظیمات ربات تلگرام خود هم قرار دهید.
INTERNAL_API_KEY="یک-رشته-تصادفی-طولانی-برای-ربات-تلگرام"
