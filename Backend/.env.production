# Backend .env.production template
# این فایل نمونه برای قرار دادن در /etc/byelimit/.env روی سرور است.
# حتماً این فایل را با مقادیر واقعی جایگزین کرده و دسترسی فایل را محدود کنید (chmod 600).

# ---------- دیتابیس (Postgres) ----------
# مثال: postgres://byelimit_user:strongpassword@127.0.0.1:5432/byelimit_db
DATABASE_URL="postgres://<DB_USER>:<DB_PASS>@127.0.0.1:5432/<DB_NAME>"

# ---------- سرور ----------
PORT=4000
NODE_ENV=production
# اگر فرانت‌اند روی www یا دامنه اصلی اجرا می‌شود، هر دو را اینجاComma-separated اضافه کنید.
FRONTEND_URL="https://byelimit.ir,https://www.byelimit.ir"
# اگر frontend روی همان سرور و روی دامنه اصلی اجرا می‌شود BACKEND_URL می‌تواند برابر FRONTEND_URL باشد
BACKEND_URL="https://byelimit.ir"
COOKIE_DOMAIN=".byelimit.ir"

# ---------- JWT (احراز هویت) ----------
# مقدار JWT_SECRET را روی سرور تولید و قرار دهید (حداقل 32 بایت تصادفی). مثال تولید در README-deploy.md
JWT_SECRET="<GENERATE_SECURE_JWT_SECRET_ON_SERVER>"
JWT_EXPIRES_IN="33d"

# ---------- ملی پیامک (پیامک OTP) ----------
# اعتبارنامه واقعی را بعداً در اینجا وارد کنید.
# برای ارسال پیامک، معمولاً نام کاربری و رمز پنل ملی پیامک لازم است.
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
MELIPAYAMAK_FROM=""
MELIPAYAMAK_API_KEY=""
MELIPAYAMAK_OTP_TEMPLATE="byelimit-login"

# ---------- زرین‌پال ----------
ZARINPAL_MERCHANT_ID=""
# تا زمان گرفتن مرچنت واقعی true بگذارید
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL="https://byelimit.ir/api/payment/callback"

# ---------- ردیس (برای BullMQ - صف تحویل و اعلان تلگرام) ----------
# اگر Redis روی همان سرور است:
REDIS_URL="redis://:CHANGEME_REDIS_PASS@127.0.0.1:6379"

# ---------- رمزنگاری اطلاعات حساس (مثل کردنشیال اکانت‌ها) ----------
# ACCOUNT_CREDENTIALS_ENCRYPTION_KEY را روی سرور تولید کنید (۳۲ بایت raw -> hex یا base64)
ACCOUNT_CREDENTIALS_ENCRYPTION_KEY="<GENERATE_32_BYTE_KEY_ON_SERVER>"

# ---------- API داخلی ربات تلگرام پشتیبانی ----------
INTERNAL_API_KEY="<GENERATE_INTERNAL_API_KEY_ON_SERVER>"

# ---------- گزینه‌های اضافی ----------
# LOG_LEVEL=info
# SENTRY_DSN=
# ...

# ====== نکات امنیتی ======
# 1. هرگز این فایل را به گیت کامیت نکنید.
# 2. مسیر پیشنهادی در systemd unit: /etc/byelimit/.env
# 3. دسترسی فایل را محدود کنید: sudo chown deploy:deploy /etc/byelimit/.env && sudo chmod 600 /etc/byelimit/.env
