[Unit]
Description=ByeLimit Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/byelimit/Frontend
EnvironmentFile=/etc/byelimit/.env
# Assumes `npm run start` maps to `next start -p 3000` in package.json
ExecStart=/usr/bin/npm run start --prefix /var/www/byelimit/Frontend
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
