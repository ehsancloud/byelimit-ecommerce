[Unit]
Description=ByeLimit Worker (BullMQ)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/byelimit/Backend
EnvironmentFile=/etc/byelimit/.env
ExecStart=/usr/bin/node src/jobs/worker.js
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
