# nginx site config template for ByeLimit
# Copy to /etc/nginx/sites-available/byelimit and symlink to sites-enabled
# Then run: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name byelimit.ir www.byelimit.ir api.byelimit.ir;

    # Redirect all HTTP to HTTPS (handled by certbot later)
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server (after obtaining certs)
server {
    listen 443 ssl http2;
    server_name byelimit.ir www.byelimit.ir;

    ssl_certificate /etc/letsencrypt/live/byelimit.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/byelimit.ir/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security headers
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy no-referrer-when-downgrade;

    # Frontend (Next.js)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API (backend)
    location /api/ {
        proxy_pass http://127.0.0.1:4000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Healthcheck
    location /health {
      proxy_pass http://127.0.0.1:4000/health;
    }

    # Static files like Next.js' static assets will be proxied to next process
}

# Optional: separate server for API subdomain
server {
    listen 443 ssl http2;
    server_name api.byelimit.ir;

    ssl_certificate /etc/letsencrypt/live/byelimit.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/byelimit.ir/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
