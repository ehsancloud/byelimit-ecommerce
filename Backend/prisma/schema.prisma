// prisma/schema.prisma
// بک‌اند بای لیمیت - مدل دیتابیس PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== کاربران و احراز هویت (OTP کاوه‌نگار) =====================

model User {
  id           String   @id @default(uuid())
  mobile       String   @unique
  fullName     String?
  telegramId   String?
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  carts  Cart[]
  orders Order[]

  @@map("users")
}

model OtpCode {
  id           String    @id @default(uuid())
  mobile       String
  codeHash     String
  purpose      OtpPurpose @default(LOGIN)
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(5)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  ipAddress    String?

  @@index([mobile, purpose])
  @@map("otp_codes")
}

enum OtpPurpose {
  LOGIN
  CHECKOUT_VERIFY
}

enum PricingMode {
  DYNAMIC_USD
  FIXED_RIAL
}

enum ProfitMode {
  NONE
  PERCENT
  FIXED
}

enum PaymentGateway {
  ZIBAL
  ZARINPAL
}

// ===================== محصولات =====================

model Product {
  id              String   @id @default(uuid())
  slug            String   @unique
  sku             String   @unique
  category        String
  title           String
  subtitle        String?
  metaTitle       String
  metaDescription String
  mainImage       String
  requiresVpn     Boolean  @default(true)
  vpnNote         String?
  longDescription String?
  ratingAverage   Float?
  ratingCount     Int      @default(0)
  monthlySalesCount Int    @default(0)
  totalSalesCount   Int    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants   ProductVariant[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  flashDeals FlashDeal[]  // ✅ NEW relation

  @@index([category])
  @@map("products")
}

model ProductVariant {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String
  productTitle       String?
  type               String?
  durationDays       Int?
  priceRial          BigInt?
  originalPriceRial  BigInt?
  costUsd            Decimal? @db.Decimal(10, 2)
  sourcingRegion     String?
  deliveryTimeMinutes Int     @default(0)
  isPopular          Boolean @default(false)
  isActive           Boolean @default(true)
  // ═══════ قیمت‌گذاری پویا (USDT) / ثابت ═══════
  pricingMode        PricingMode @default(DYNAMIC_USD)
  fixedPriceRial     BigInt?       // قیمت ثابت (اگر FIXED_RIAL باشد)
  basePriceRial      BigInt?       // قیمت تمام‌شده (قبل از سود)
  profitMode         ProfitMode @default(NONE)
  profitValue        Decimal? @db.Decimal(10, 2) // درصد یا مبلغ ثابت (ریال)
  lastPricedAt       DateTime?     // آخرین به‌روزرسانی خودکار قیمت
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cartItems     CartItem[]
  orderItems    OrderItem[]
  accountPool   AccountInventory[]
  addOns        ProductAddOn[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_variants")
}

model AccountInventory {
  id                    String   @id @default(uuid())
  variantId             String
  variant               ProductVariant @relation(fields: [variantId], references: [id])
  credentialsEncrypted  String
  status                AccountStatus @default(AVAILABLE)
  reservedForOrderId    String?
  reservedAt            DateTime?
  soldAt                DateTime?
  createdAt             DateTime @default(now())

  orderItem OrderItem?

  @@index([variantId, status])
  @@map("account_inventory")
}

enum AccountStatus {
  AVAILABLE
  RESERVED
  SOLD
  REVOKED
}

// ===================== سبد خرید =====================

model Cart {
  id          String     @id @default(uuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  guestToken  String?    @unique
  status      CartStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items CartItem[]
  order Order?

  @@index([userId])
  @@map("carts")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model CartItem {
  id             String   @id @default(uuid())
  cartId         String
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  // افزودنی انتخاب‌شده (مثل پرداخت امن بین‌المللی کلاد) - اختیاری
  addOnId        String?
  addOn          ProductAddOn? @relation(fields: [addOnId], references: [id])
  quantity       Int      @default(1)
  unitPriceRial  BigInt
  createdAt      DateTime @default(now())

  @@index([cartId])
  @@map("cart_items")
}

// ===================== کدهای تخفیف =====================

model DiscountCode {
  id                  String    @id @default(uuid())
  code                String    @unique
  type                DiscountType
  amountRial          BigInt?
  percent             Int?
  maxUses             Int?
  usedCount           Int       @default(0)
  expiresAt           DateTime?
  isActive            Boolean   @default(true)
  minCartAmountRial   BigInt?
  maxDiscountRial     BigInt?
  metadata            Json?
  createdAt           DateTime  @default(now())

  orders Order[]

  @@map("discount_codes")
}

enum DiscountType {
  FIXED
  PERCENT
}

// ===================== سفارش / پیش‌فاکتور =====================

model Order {
  id             String       @id @default(uuid())
  orderNumber    String       @unique @default(uuid())
  cartId         String?      @unique
  cart           Cart?        @relation(fields: [cartId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  mobile         String
  telegramId     String?
  fullName       String?
  status         OrderStatus  @default(PENDING_PAYMENT)
  subtotalRial   BigInt
  discountRial   BigInt       @default(0)
  totalRial      BigInt
  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items      OrderItem[]
  payments   Payment[]
  auditLogs  AuditLog[]
  telegramNotifications TelegramNotification[]

  @@index([mobile])
  @@index([status])
  @@index([userId])
  @@map("orders")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  DELIVERED
  FAILED
  REFUNDED
  CANCELLED
}

model OrderItem {
  id                    String   @id @default(uuid())
  orderId               String
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId              String
  product                Product  @relation(fields: [productId], references: [id])
  variantId              String
  variant                ProductVariant @relation(fields: [variantId], references: [id])
  productTitleSnapshot   String
  variantNameSnapshot    String
  addOnNameSnapshot      String?
  addOnPriceRial         BigInt?
  unitPriceRial          BigInt
  quantity               Int      @default(1)
  assignedAccountId      String?  @unique
  assignedAccount        AccountInventory? @relation(fields: [assignedAccountId], references: [id])
  createdAt              DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

// ===================== پرداخت (زرین‌پال) =====================

model Payment {
  id                    String        @id @default(uuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway               PaymentGateway @default(ZIBAL)
  authority             String        @unique
  gatewayTrackId        BigInt?       // trackId زیبال
  refId                  String?
  amountRial             BigInt
  feeRial                BigInt?
  status                 PaymentStatus @default(PENDING)
  isSandbox              Boolean       @default(false)
  gatewayErrorCode       String?
  cardPanMasked          String?
  sessionSnapshot        Json?
  gatewayMetadata        Json?         // پاسخ خام درگاه
  verifiedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([orderId])
  @@index([gateway, authority])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REVERSED
}

// ===================== ثبت تاریخچه (Audit Log) =====================

model AuditLog {
  id             String   @id @default(uuid())
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id])
  entityType     String
  entityId       String
  action         String
  previousStatus String?
  newStatus      String?
  actorType      String
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@map("audit_logs")
}

// ===================== اعلانات تلگرام =====================

model TelegramNotification {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payload   Json
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("telegram_notifications")
}

// ===================== پیشنهادات ویژه (قابل تنظیم از Prisma Studio) =====================

/// پیشنهادات ویژه / Flash Deals - از Prisma Studio قابل مدیریت است.
/// برای افزودن پیشنهاد جدید: productId را انتخاب کنید، isActive = true، endsAt = زمان پایان (اختیاری).
/// واریانتی که originalPriceRial > priceRial باشد به‌طور خودکار برای نمایش تخفیف انتخاب می‌شود.
model FlashDeal {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// زمان پایان تخفیف - null یعنی بدون تایمر (تخفیف دائمی)
  endsAt    DateTime?
  /// ترتیب نمایش در کروسل (کوچکتر = اول)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("flash_deals")
}

// ===================== افزودنی‌های محصول (Add-On) =====================

model ProductAddOn {
  id          String         @id @default(uuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priceRial   BigInt
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  cartItems   CartItem[]

  @@index([variantId])
  @@map("product_add_ons")
}

// ===================== نرخ ارز (USDT) =====================

/// تنظیمات و آخرین نرخ دریافت‌شده از ابان‌تتر. فقط یک رکورد (id = "singleton").
model ExchangeRateSetting {
  id               String   @id @default("singleton")
  sourceBuyPrice   Float    @default(0) // قیمت خرید خام از API
  roundedRate      Int      @default(0) // نرخ گرد‌شده کاربردی (با ۲٪ کرایه)
  displayRate      Int      @default(0) // نرخ نمایشی (تمیز و کمی پایین‌تر)
  lastFetchedAt    DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("exchange_rate_settings")
}
