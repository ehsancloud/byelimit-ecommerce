// Backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== کاربران و احراز هویت =====================

model User {
  id          String   @id @default(uuid())
  mobile      String   @unique
  fullName    String?
  telegramId  String?
  createdAt   DateTime @default(now())
  lastLoginAt DateTime?

  carts   Cart[]
  orders  Order[]
  reviews Review[]

  @@map("users")
}

model OtpCode {
  id           String     @id @default(uuid())
  mobile       String
  codeHash     String
  purpose      OtpPurpose @default(LOGIN)
  attemptCount Int        @default(0)
  maxAttempts  Int        @default(5)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime   @default(now())
  ipAddress    String?

  @@index([mobile, purpose])
  @@map("otp_codes")
}

enum OtpPurpose {
  LOGIN
  CHECKOUT_VERIFY
}

// ===================== محصولات و سئو =====================

model Product {
  id                String   @id @default(uuid())
  slug              String   @unique
  sku               String   @unique
  category          String
  title             String
  subtitle          String?
  metaTitle         String
  metaDescription   String
  mainImage         String
  requiresVpn       Boolean  @default(true)
  vpnNote           String?
  longDescription   String?
  demoVideoUrl      String?

  /// فیلدهای داینامیک سئو و محتوا - قابل ویرایش از Prisma Studio
  faqs              Json?    // ساختار: [{ question: "...", answer: "..." }]
  comparisonTable   Json?    // ساختار: [{ feature: "...", shared: "...", exclusive: "..." }]
  features          Json?    // لیست ویژگی‌ها: ["...", "..."]

  ratingAverage     Float?
  ratingCount       Int      @default(0)
  monthlySalesCount Int      @default(0)
  totalSalesCount   Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variants   ProductVariant[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  flashDeals FlashDeal[]
  reviews    Review[]

  @@index([category])
  @@map("products")
}

model ProductVariant {
  id                  String   @id @default(uuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                String
  productTitle        String?
  type                String?
  durationDays        Int?
  priceRial           BigInt?
  originalPriceRial   BigInt?
  costUsd             Decimal? @db.Decimal(10, 2)
  sourcingRegion      String?
  deliveryTimeMinutes Int      @default(0)
  isPopular           Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cartItems    CartItem[]
  orderItems   OrderItem[]
  accountPool  AccountInventory[]
  priceConfig  ProductPriceConfig?

  @@unique([productId, name])
  @@index([productId])
  @@map("product_variants")
}

model ProductPriceConfig {
  id             String     @id @default(uuid())
  variantId      String     @unique
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  useUsdFormula  Boolean    @default(true)
  fixedPriceRial BigInt?
  profitType     ProfitType @default(PERCENT)
  profitPercent  Float?     @default(10)
  profitFixedRial BigInt?

  updatedAt      DateTime   @updatedAt

  @@map("product_price_configs")
}

enum ProfitType {
  PERCENT
  FIXED_RIAL
}

model AccountInventory {
  id                   String        @id @default(uuid())
  variantId            String
  variant              ProductVariant @relation(fields: [variantId], references: [id])
  credentialsEncrypted String
  status               AccountStatus @default(AVAILABLE)
  reservedForOrderId   String?
  reservedAt           DateTime?
  soldAt               DateTime?
  createdAt            DateTime      @default(now())

  orderItem OrderItem?

  @@index([variantId, status])
  @@map("account_inventory")
}

enum AccountStatus {
  AVAILABLE
  RESERVED
  SOLD
  REVOKED
}

// ===================== نظرات کاربران =====================

model Review {
  id         String       @id @default(uuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id])
  authorName String       @default("کاربر بای لیمیت")
  rating     Int          @default(5)
  comment    String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([productId, status])
  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ===================== مقالات وبلاگ سئو =====================

model BlogPost {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  excerpt         String?
  content         String
  coverImage      String?
  metaTitle       String?
  metaDescription String?
  published       Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@map("blog_posts")
}

// ===================== سبد خرید =====================

model Cart {
  id         String     @id @default(uuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id])
  guestToken String?    @unique
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items CartItem[]
  order Order?

  @@index([userId])
  @@map("carts")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model CartItem {
  id             String   @id @default(uuid())
  cartId         String
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  quantity       Int      @default(1)
  unitPriceRial  BigInt

  /// پشتیبانی از سرویس ویژه پرداخت بین‌المللی
  hasSecureAddon Boolean  @default(false)
  addonPriceRial BigInt   @default(0)

  createdAt      DateTime @default(now())

  @@index([cartId])
  @@map("cart_items")
}

// ===================== کدهای تخفیف =====================

model DiscountCode {
  id                String       @id @default(uuid())
  code              String       @unique
  type              DiscountType
  amountRial        BigInt?
  percent           Int?
  maxUses           Int?
  usedCount         Int          @default(0)
  expiresAt         DateTime?
  isActive          Boolean      @default(true)
  minCartAmountRial BigInt?
  maxDiscountRial   BigInt?
  metadata          Json?
  createdAt         DateTime     @default(now())

  orders Order[]

  @@map("discount_codes")
}

enum DiscountType {
  FIXED
  PERCENT
}

// ===================== سفارش =====================

// بخش Order در schema.prisma را به این شکل ویرایش کنید:
model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  cartId         String?     @unique
  cart           Cart?       @relation(fields: [cartId], references: [id])
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  mobile         String
  telegramId     String?
  fullName       String?
  status         OrderStatus @default(PENDING_PAYMENT)
  subtotalRial   BigInt
  discountRial   BigInt      @default(0)
  totalRial      BigInt
  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items                  OrderItem[]
  payments               Payment[]
  auditLogs              AuditLog[]
  telegramNotifications  TelegramNotification[]

  @@index([mobile])
  @@index([status])
  @@index([userId])
  @@map("orders")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  DELIVERED
  FAILED
  REFUNDED
  CANCELLED
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String
  product              Product  @relation(fields: [productId], references: [id])
  variantId            String
  variant              ProductVariant @relation(fields: [variantId], references: [id])
  productTitleSnapshot String
  variantNameSnapshot  String
  unitPriceRial        BigInt
  quantity             Int      @default(1)

  /// ثبت دائمی وضعیت سرویس پرداخت بین‌المللی برای ادمین
  hasSecureAddon       Boolean  @default(false)
  addonPriceRial       BigInt   @default(0)

  assignedAccountId    String?  @unique
  assignedAccount      AccountInventory? @relation(fields: [assignedAccountId], references: [id])
  createdAt            DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

// ===================== پرداخت (زیبال) =====================

model Payment {
  id               String        @id @default(uuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway          PaymentGateway @default(ZIBAL)
  authority        String        @unique
  refId            String?
  amountRial       BigInt
  feeRial          BigInt?
  status           PaymentStatus @default(PENDING)
  isSandbox        Boolean       @default(false)
  gatewayErrorCode String?
  cardPanMasked    String?
  sessionSnapshot  Json?
  verifiedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderId])
  @@map("payments")
}

enum PaymentGateway {
  ZARINPAL
  ZIBAL
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REVERSED
}

// ===================== نرخ ارز (USDT) =====================

model UsdRate {
  id           String   @id @default(uuid())
  buyPrice     Float
  displayPrice Float
  roundedRate  Float
  fetchedAt    DateTime @default(now())

  @@map("usd_rates")
}

// ===================== Audit Log =====================

model AuditLog {
  id             String   @id @default(uuid())
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id])
  entityType     String
  entityId       String
  action         String
  previousStatus String?
  newStatus      String?
  actorType      String
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@map("audit_logs")
}

// ===================== اعلانات تلگرام =====================

model TelegramNotification {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payload   Json
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("telegram_notifications")
}

// ===================== Flash Deals =====================

model FlashDeal {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  endsAt    DateTime?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("flash_deals")
}