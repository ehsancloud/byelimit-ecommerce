# .env.local.example
# این فایل را کپی کرده و به .env.local تغییر نام دهید (برای توسعه لوکال)
# در پروداکشن (لیارا)، این متغیر را در پنل "متغیرهای محیطی" همان اپ وارد کنید.

# آدرس بک‌اند - در توسعه لوکال روی پورت پیش‌فرض بک‌اند
NEXT_PUBLIC_API_URL="http://localhost:4000"
# برای سمت سرور (server-side data fetching) اگر لازم شد:
# BACKEND_URL="http://localhost:4000"

# در پروداکشن مثلاً:
# NEXT_PUBLIC_API_URL="https://api.byelimit.ir"
# BACKEND_URL="https://api.byelimit.ir"

# دامنه اصلی سایت برای Sitemap و RSS:
# NEXT_PUBLIC_SITE_URL="https://byelimit.ir"
